<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_visualizar_trilha.xml -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map_visualizar"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Overlay superior com estatísticas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#DD000000"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_vis_nome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome da trilha"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_vis_data_inicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Início: -"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tv_vis_data_fim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fim: -"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tv_vis_duracao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duração: -"
                    android:textColor="#80CBC4"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_vis_vel_media"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vel. Média: 0.0 km/h"
                    android:textColor="#4FC3F7"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_vis_vel_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vel. Máx: 0.0 km/h"
                    android:textColor="#FF8A65"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_vis_distancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distância: 0.00 km"
                    android:textColor="#81C784"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Botão voltar (canto inferior) -->
    <Button
        android:id="@+id/btn_vis_voltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Voltar"
        android:backgroundTint="#37474F"
        android:textColor="#FFFFFF"/>

</FrameLayout>